---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="404 | PollyPM"
	description="The page you requested does not exist on PollyPM. Return to the home page or continue with the documentation hub."
	noindex={true}
>
	<div class="page-shell">
		<header class="site-header">
			<div class="container nav-row">
				<a class="brand" href="/">
					<span class="brand-mark"><span>PP</span></span>
					<span class="brand-copy">
						<small>PollyPM</small>
						<strong>Page Not Found</strong>
					</span>
				</a>
				<nav class="nav-links" aria-label="Primary">
					<a href="/">Home</a>
					<a href="/docs">Docs</a>
					<a href="/docs/getting-started">Getting Started</a>
					<a href="/docs/faq">FAQ</a>
				</nav>
			</div>
		</header>

		<main id="main-content">
			<section class="docs-hero">
				<div class="container">
					<span class="eyebrow">404 error</span>
					<h1>This route is empty.</h1>
					<p>The page may have moved, or the URL is wrong. Use the links below to jump back into the site.</p>
					<div class="button-row">
						<a class="button button-primary" href="/">Go home</a>
						<a class="button button-secondary" href="/docs">Open docs</a>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="container split-grid">
					<div class="info-panel">
						<div class="section-heading">
							<h2>Common next steps</h2>
						</div>
						<ul>
							<li>Return to the marketing homepage.</li>
							<li>Open the docs overview and choose the right guide.</li>
							<li>Jump to getting started, concepts, or FAQ.</li>
						</ul>
					</div>

					<div class="cta-panel">
						<div>
							<h2>Start from a known route.</h2>
							<p>Use the docs if you want setup or architecture guidance, or the home page if you want the product overview.</p>
						</div>
						<div class="button-row">
							<a class="button button-primary" href="/">Home</a>
							<a class="button button-secondary" href="/docs">Docs home</a>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="container footer-row">
				<div class="footer-brand-block">
					<a class="brand" href="/">
						<span class="brand-mark"><span>PP</span></span>
						<span class="brand-copy">
							<small>PollyPM</small>
							<strong>Operator-facing docs for multi-agent engineering</strong>
						</span>
					</a>
				</div>
				<div class="footer-link-groups">
					<nav class="footer-nav-group" aria-label="Site">
						<strong>Site</strong>
						<a href="/">Home</a>
						<a href="/#features">Features</a>
						<a href="/#how-it-works">How it works</a>
					</nav>
					<nav class="footer-nav-group" aria-label="Docs">
						<strong>Docs</strong>
						<a href="/docs">Docs home</a>
						<a href="/docs/getting-started">Getting Started</a>
						<a href="/docs/concepts">Concepts</a>
						<a href="/docs/cli-reference">CLI Reference</a>
						<a href="/docs/faq">FAQ</a>
					</nav>
				</div>
			</div>
		</footer>
	</div>
</Layout>
