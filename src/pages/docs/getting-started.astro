---
import Layout from '../../layouts/Layout.astro';

const prerequisites = [
	'Node.js 22.12 or newer on the operator machine.',
	'Git access to every repository PollyPM will coordinate.',
	'`tmux` installed so sessions can survive terminal disconnects.',
	'Provider credentials for the models you want PollyPM to route work through.',
];

const installSteps = [
	{
		command: 'npm install -g pollypm',
		description: 'Install the CLI globally so operators can launch and monitor projects from any checkout.',
	},
	{
		command: 'pollypm --version',
		description: 'Confirm the binary is available before you configure projects or credentials.',
	},
	{
		command: 'tmux -V && git --version',
		description: 'Verify the two core runtime dependencies PollyPM expects to use during execution.',
	},
];

const configExamples = [
	{
		title: 'Environment variables',
		description: 'Expose provider keys to the shell that will run PollyPM. Keep credentials outside the repository.',
		command: `export OPENAI_API_KEY="sk-live-..."
export ANTHROPIC_API_KEY="sk-ant-..."
export POLLYPM_DEFAULT_PROVIDER="openai"`,
	},
	{
		title: 'Project bootstrap',
		description: 'Initialize a named project and register the repositories PollyPM should supervise.',
		command: `pollypm init --project launch-redesign \\
  --repo web=~/dev/company-web \\
  --repo api=~/dev/company-api`,
	},
	{
		title: 'Optional fallback route',
		description: 'Define the backup provider path PollyPM can use if a session stalls or the primary route hits limits.',
		command: `pollypm providers set-fallback \\
  --primary openai:gpt-5.4 \\
  --fallback anthropic:claude-sonnet`,
	},
];

const concepts = [
	{
		title: 'Project',
		description:
			'The top-level coordination unit. It defines the repos, the operator goal, and the sessions PollyPM manages together.',
	},
	{
		title: 'Session',
		description:
			'One managed execution lane assigned to a specific task, branch, worktree, and provider route.',
	},
	{
		title: 'Worktree',
		description:
			'A separate Git checkout PollyPM uses so parallel agent work does not collide in the same branch or directory.',
	},
	{
		title: 'Provider path',
		description:
			'The current model route for a session, including the primary provider and the configured fallback behavior.',
	},
];

const firstRunCommands = [
	{
		command: 'pollypm launch --project launch-redesign --session frontend-refresh --task "Refresh homepage copy and layout"',
		description: 'Start the first managed lane and assign it a concrete, reviewable goal.',
	},
	{
		command: 'pollypm launch --project launch-redesign --session docs-pass --task "Expand getting started documentation"',
		description: 'Add a second lane to validate that PollyPM can coordinate parallel work cleanly.',
	},
	{
		command: 'pollypm monitor --project launch-redesign',
		description: 'Watch heartbeats, provider assignments, and session health from one operator view.',
	},
	{
		command: 'pollypm handoff --session docs-pass --to operator',
		description: 'Pull a lane back to human review when it is ready for verification or needs intervention.',
	},
];

const firstRunChecklist = [
	'Create a small pilot project before you onboard a full delivery pipeline.',
	'Start with two lanes so you can verify worktree isolation and operator visibility.',
	'Watch `pollypm monitor` until you see stable heartbeats and clear session ownership.',
	'Review the Git changes in each worktree before you widen the rollout.',
];

const troubleshooting = [
	{
		title: 'PollyPM cannot launch sessions',
		description: 'Usually means `tmux` is missing, the provider key is not exported, or the target repository path is wrong.',
	},
	{
		title: 'A lane stops reporting health',
		description: 'Use monitor output first. If the session is stalled, reassign it to a fallback provider or hand it back to an operator.',
	},
	{
		title: 'Changes collide between lanes',
		description: 'Check that each session launched into its own worktree and that tasks are scoped to separate file ownership.',
	},
];
---

<Layout
	title="Getting Started | PollyPM Docs"
	description="Install PollyPM, configure providers, initialize your first project, and launch managed agent lanes with confidence."
>
	<div class="page-shell">
		<header class="site-header">
			<div class="container nav-row">
				<a class="brand" href="/">
					<span class="brand-mark"><span>PP</span></span>
					<span class="brand-copy">
						<small>PollyPM Docs</small>
						<strong>Getting Started</strong>
					</span>
				</a>
				<nav class="nav-links" aria-label="Documentation">
					<a href="/">Home</a>
					<a href="/docs/concepts">Concepts</a>
					<a href="/docs/cli-reference">CLI Reference</a>
					<a href="/#features">Features</a>
					<a href="/#how-it-works">How It Works</a>
				</nav>
			</div>
		</header>

		<main>
			<section class="docs-hero">
				<div class="container">
					<span class="eyebrow">Documentation</span>
					<h1>Install PollyPM and launch your first managed lanes.</h1>
					<p>
						This guide covers the minimum setup for a real first run: prepare the machine,
						configure providers, initialize a project, launch sessions, and verify that the
						operator loop is working.
					</p>
					<div class="docs-meta">
						<span class="chip">Installation</span>
						<span class="chip">Configuration</span>
						<span class="chip">First run</span>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="container split-grid">
					<div class="info-panel">
						<div class="section-heading">
							<h2>1. Check prerequisites</h2>
							<p>PollyPM coordinates existing tools. It works best when the local machine is already stable.</p>
						</div>
						<ul>
							{prerequisites.map((item) => <li>{item}</li>)}
						</ul>
					</div>

					<div class="info-panel">
						<div class="section-heading">
							<h2>2. Install the CLI</h2>
							<p>Install once, then verify the runtime before you register any projects.</p>
						</div>
						<ul class="command-list">
							{
								installSteps.map((item) => (
									<li>
										<code>{item.command}</code>
										<span>{item.description}</span>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="container split-grid">
					<div class="info-panel">
						<div class="section-heading">
							<h2>3. Configure providers and project scope</h2>
							<p>These examples show the minimum shell and project setup for a usable first launch.</p>
						</div>
						<ul class="command-list">
							{
								configExamples.map((example) => (
									<li>
										<code>{example.title}</code>
										<span>{example.description}</span>
										<pre><code>{example.command}</code></pre>
									</li>
								))
							}
						</ul>
					</div>

					<div class="info-panel">
						<div class="section-heading">
							<h2>What PollyPM is managing</h2>
							<p>These concepts are the core operating model behind every PollyPM command.</p>
						</div>
						<div class="concept-grid">
							{
								concepts.map((concept) => (
									<article class="doc-card">
										<strong>{concept.title}</strong>
										<p>{concept.description}</p>
									</article>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="container split-grid">
					<div class="info-panel">
						<div class="section-heading">
							<h2>4. Run the first project</h2>
							<p>Start with a small pilot and watch the system behave before you scale to more lanes.</p>
						</div>
						<ul class="command-list">
							{
								firstRunCommands.map((item) => (
									<li>
										<code>{item.command}</code>
										<span>{item.description}</span>
									</li>
								))
							}
						</ul>
					</div>

					<div class="info-panel">
						<div class="section-heading">
							<h2>First-run checklist</h2>
							<p>Use this list to decide whether the pilot is healthy enough to expand.</p>
						</div>
						<ul class="timeline">
							{firstRunChecklist.map((item, index) => (
								<li>
									<strong>Check {index + 1}</strong>
									<span>{item}</span>
								</li>
							))}
						</ul>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="container">
					<div class="section-heading">
						<h2>Troubleshooting the first launch</h2>
						<p>Most early issues are environment, credentials, or task-boundary problems rather than product failures.</p>
					</div>
					<div class="docs-grid">
						{
							troubleshooting.map((item) => (
								<article class="doc-card">
									<strong>{item.title}</strong>
									<p>{item.description}</p>
								</article>
							))
						}
					</div>

					<div class="cta-panel">
						<div>
							<h2>Start narrow, then widen the rollout.</h2>
							<p>
								If the first two lanes stay healthy, their worktrees stay isolated, and the operator
								can review output cleanly, you are ready to onboard a larger project.
							</p>
						</div>
						<div class="button-row">
							<a class="button button-primary" href="/docs/concepts">Read concepts</a>
							<a class="button button-secondary" href="/docs/cli-reference">Open CLI reference</a>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="container footer-row">
				<div>
					<a class="brand" href="/">
						<span class="brand-mark"><span>PP</span></span>
						<span class="brand-copy">
							<small>PollyPM</small>
							<strong>Operator-facing documentation for AI project management</strong>
						</span>
					</a>
				</div>
				<nav class="footer-links" aria-label="Footer">
					<a href="/">Home</a>
					<a href="/docs/concepts">Concepts</a>
					<a href="/docs/cli-reference">CLI Reference</a>
					<a href="/#docs">Docs overview</a>
					<a href="/#features">Capabilities</a>
				</nav>
			</div>
		</footer>
	</div>
</Layout>
