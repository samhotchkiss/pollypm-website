---
import Layout from '../../layouts/Layout.astro';

const commands = [
	{
		command: 'pollypm init',
		description: 'Create PollyPM project metadata and register the repositories that belong to the initiative.',
	},
	{
		command: 'pollypm launch --project api-upgrade',
		description: 'Start the first managed agent sessions with tmux-backed execution lanes and operator visibility.',
	},
	{
		command: 'pollypm monitor --project api-upgrade',
		description: 'Inspect live health, heartbeats, session ownership, and failover events from one dashboard.',
	},
	{
		command: 'pollypm handoff --session docs-pass',
		description: 'Transfer work to another agent or operator checkpoint without losing context or execution history.',
	},
];

const concepts = [
	{
		title: 'Project',
		description:
			'The umbrella object that ties together repos, goals, active sessions, and operator checkpoints.',
	},
	{
		title: 'Session',
		description:
			'A managed agent runtime with a role, a task boundary, a provider assignment, and a heartbeat lifecycle.',
	},
	{
		title: 'Worktree',
		description:
			'An isolated Git workspace for safe parallel implementation and clean merges back to the primary branch.',
	},
	{
		title: 'Provider path',
		description:
			'The specific model, vendor, or account PollyPM is using for a session, including the fallback chain when conditions change.',
	},
];
---

<Layout
	title="Getting Started | PollyPM Docs"
	description="Install PollyPM, understand the core operating model, and launch your first managed multi-agent project."
>
	<div class="page-shell">
		<header class="site-header">
			<div class="container nav-row">
				<a class="brand" href="/">
					<span class="brand-mark"><span>PP</span></span>
					<span class="brand-copy">
						<small>PollyPM Docs</small>
						<strong>Getting Started</strong>
					</span>
				</a>
				<nav class="nav-links" aria-label="Documentation">
					<a href="/">Home</a>
					<a href="/#features">Features</a>
					<a href="/#how-it-works">How It Works</a>
				</nav>
			</div>
		</header>

		<main>
			<section class="docs-hero">
				<div class="container">
					<span class="eyebrow">Documentation</span>
					<h1>Getting started with a PM layer for AI agents.</h1>
					<p>
						PollyPM is most useful when you stop thinking about individual prompts and start
						thinking in terms of managed execution lanes. This guide gives you the minimum model
						you need to install the system, launch your first project, and understand what PollyPM
						is managing on your behalf.
					</p>
					<div class="docs-meta">
						<span class="chip">Static docs with operator focus</span>
						<span class="chip">CLI-first workflow</span>
						<span class="chip">Multi-repo friendly</span>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="container split-grid">
					<div class="info-panel">
						<div class="section-heading">
							<h2>1. Prepare the environment</h2>
							<p>
								PollyPM works best when your repositories, local credentials, and terminal
								environment are already stable. It is designed to orchestrate execution, not hide
								basic machine setup problems.
							</p>
						</div>
						<ul>
							<li>Install PollyPM on the machine or runner that will coordinate agent sessions.</li>
							<li>Confirm the required provider credentials are available to the environment.</li>
							<li>Make sure `tmux`, Git, and your preferred editors are ready for operator review.</li>
							<li>Choose the repositories PollyPM will manage and verify local checkout access.</li>
						</ul>
					</div>

					<div class="info-panel">
						<div class="section-heading">
							<h2>2. Initialize a project</h2>
							<p>
								Projects are the top-level unit of coordination. They define scope, repositories,
								and the execution lanes that PollyPM will supervise.
							</p>
						</div>
						<ul class="command-list">
							{
								commands.slice(0, 2).map((item) => (
									<li>
										<code>{item.command}</code>
										<span>{item.description}</span>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="container">
					<div class="section-heading">
						<h2>Core concepts</h2>
						<p>
							These are the abstractions PollyPM uses to turn several agent runtimes into one
							operable delivery system.
						</p>
					</div>
					<div class="concept-grid">
						{
							concepts.map((concept) => (
								<article class="doc-card">
									<strong>{concept.title}</strong>
									<p>{concept.description}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="section">
				<div class="container split-grid">
					<div class="info-panel">
						<div class="section-heading">
							<h2>Day-one commands</h2>
							<p>
								The initial operator loop is simple: launch work, watch health, and intervene only
								when a handoff or reassignment is warranted.
							</p>
						</div>
						<ul class="command-list">
							{
								commands.map((item) => (
									<li>
										<code>{item.command}</code>
										<span>{item.description}</span>
									</li>
								))
							}
						</ul>
					</div>

					<div class="info-panel">
						<div class="section-heading">
							<h2>Suggested rollout</h2>
							<p>
								Start narrow. Prove that the system can coordinate a few high-value lanes before
								you put your entire delivery process on top of it.
							</p>
						</div>
						<ul class="timeline">
							<li>
								<strong>Week 1</strong>
								<span>Run one project with two or three agent lanes and validate worktree hygiene.</span>
							</li>
							<li>
								<strong>Week 2</strong>
								<span>Introduce heartbeat monitoring and confirm operators can recover stalled sessions quickly.</span>
							</li>
							<li>
								<strong>Week 3</strong>
								<span>Exercise provider failover on a real task so account limits do not become a surprise later.</span>
							</li>
							<li>
								<strong>Week 4</strong>
								<span>Expand to multi-repo execution and formalize review, promotion, and handoff checkpoints.</span>
							</li>
						</ul>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="container">
					<div class="cta-panel">
						<div>
							<h2>Ready to run PollyPM like infrastructure, not a demo?</h2>
							<p>
								The homepage gives the high-level story. This guide gives the operating model.
								Together they frame PollyPM as what it is: a coordination layer for serious
								multi-agent software delivery.
							</p>
						</div>
						<div class="button-row">
							<a class="button button-primary" href="/">Back to homepage</a>
							<a class="button button-secondary" href="/#how-it-works">Review how it works</a>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="container footer-row">
				<div>
					<a class="brand" href="/">
						<span class="brand-mark"><span>PP</span></span>
						<span class="brand-copy">
							<small>PollyPM</small>
							<strong>Operator-facing documentation for AI project management</strong>
						</span>
					</a>
				</div>
				<nav class="footer-links" aria-label="Footer">
					<a href="/">Home</a>
					<a href="/#docs">Docs overview</a>
					<a href="/#features">Capabilities</a>
				</nav>
			</div>
		</footer>
	</div>
</Layout>
