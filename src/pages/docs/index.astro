---
import DocsFrame from '../../components/DocsFrame.astro';

const docs = [
	{
		label: 'Start here',
		title: 'Getting Started',
		description: 'Install PollyPM, configure providers, and launch your first managed project.',
		href: '/docs/getting-started',
	},
	{
		label: 'Model',
		title: 'Concepts and Architecture',
		description: 'Understand projects, sessions, worktrees, provider paths, and the control-plane model.',
		href: '/docs/concepts',
	},
	{
		label: 'Operate',
		title: 'CLI and Configuration Reference',
		description: 'Use practical commands, config examples, and day-one operator guidance.',
		href: '/docs/cli-reference',
	},
	{
		label: 'Decide',
		title: 'FAQ',
		description: 'Read the short answers to common rollout, architecture, and operating questions.',
		href: '/docs/faq',
	},
];

const pathways = [
	'Move from installation to real project launch without guessing the order.',
	'Learn the operating model behind worktrees, provider routes, and session supervision.',
	'Keep a practical CLI reference nearby once the pilot is active.',
];
---

<DocsFrame
	title="Documentation | PollyPM Docs"
	description="Browse the PollyPM documentation: getting started, concepts, CLI reference, and FAQ."
	heroTitle="Everything you need to run PollyPM."
	heroSummary="Start with installation and first-run guidance, then move into architecture and command reference as your operator workflow gets more serious."
	currentPath="/docs"
	pills={['Onboarding', 'Concepts', 'Reference']}
>
	<section class="docs-section">
		<div class="docs-section-head">
			<span class="docs-eyebrow">Documentation Paths</span>
			<h2>Choose the page that matches where you are in the rollout.</h2>
			<p class="docs-section-copy">Each page is written for a different stage: first launch, operating model, daily command use, or evaluation.</p>
		</div>

		<div class="docs-grid">
			{
				docs.map((doc) => (
					<a class="docs-card docs-card-link" href={doc.href}>
						<span class="docs-card-label">{doc.label}</span>
						<strong>{doc.title}</strong>
						<p>{doc.description}</p>
					</a>
				))
			}
		</div>
	</section>

	<section class="docs-section">
		<div class="docs-split">
			<div class="docs-block">
				<span class="docs-card-label">Suggested route</span>
				<strong>Start with onboarding, then branch into the rest of the docs.</strong>
				<p>If you are new to PollyPM, begin with installation and the first-run guide. From there, move into concepts, CLI reference, or FAQ based on what the team needs next.</p>
			</div>

			<div class="docs-callout">
				<span class="docs-card-label">What this hub gives you</span>
				<ul class="docs-list">
					{pathways.map((item) => <li>{item}</li>)}
				</ul>
			</div>
		</div>

		<div class="docs-cta">
			<div>
				<span class="docs-card-label">Recommended next step</span>
				<strong>Open getting started and run the first pilot.</strong>
				<p class="docs-section-copy">The rest of the docs are easier to use once you have seen the operating loop in a real repository.</p>
			</div>

			<div class="docs-actions">
				<a class="docs-button primary" href="/docs/getting-started">Open getting started</a>
				<a class="docs-button secondary" href="/">Back to homepage</a>
			</div>
		</div>
	</section>
</DocsFrame>
