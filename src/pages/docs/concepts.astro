---
import DocsFrame from '../../components/DocsFrame.astro';

const concepts = [
	{
		title: 'Project',
		description:
			'A project is the top-level operating boundary in PollyPM. It groups repositories, goals, sessions, and operator checkpoints into one managed unit.',
	},
	{
		title: 'Session',
		description:
			'A session is one managed execution lane. It has a task, a provider path, a health state, and an isolated place to do work.',
	},
	{
		title: 'Worktree',
		description:
			'A worktree is the Git safety boundary for a session. It prevents parallel agents from colliding in the same checkout or branch.',
	},
	{
		title: 'Provider Path',
		description:
			'A provider path is the model route a session is currently using. PollyPM can change that route when quotas or outages block progress.',
	},
	{
		title: 'Operator',
		description:
			'The operator sets direction, watches health, and decides when to intervene, review, reroute, or shut work down.',
	},
	{
		title: 'Handoff',
		description:
			'A handoff is the controlled transfer of work between a lane and an operator or between two execution paths without losing context.',
	},
];

const architectureLayers = [
	{
		title: '1. Operator layer',
		description:
			'This is where human direction lives. Operators define scope, launch sessions, monitor health, and review output before merge or promotion.',
	},
	{
		title: '2. Control layer',
		description:
			'PollyPM itself is the control plane. It tracks projects, sessions, worktrees, health state, provider routes, and intervention history.',
	},
	{
		title: '3. Execution layer',
		description:
			'Execution happens inside managed sessions, typically backed by tmux. Each lane runs independently with a bounded task and known ownership.',
	},
	{
		title: '4. Repository layer',
		description:
			'The repository layer is where output becomes normal Git work. PollyPM keeps changes separated so review and merging stay familiar.',
	},
];

const lifecycle = [
	{
		title: 'Plan',
		description: 'Define the project and break the work into lanes with clear file or task ownership.',
	},
	{
		title: 'Launch',
		description: 'Start sessions with a scoped task, a provider path, and an isolated worktree.',
	},
	{
		title: 'Observe',
		description: 'Use health and heartbeat signals to see which lanes are progressing, waiting, or failing.',
	},
	{
		title: 'Intervene',
		description: 'Reassign, fail over, or hand work back to an operator when a lane needs help.',
	},
	{
		title: 'Review',
		description: 'Treat the output as ordinary Git changes and evaluate it with the same engineering standards you already use.',
	},
	{
		title: 'Promote',
		description: 'Merge or ship the work once the lane has produced an acceptable result.',
	},
];

const failureModes = [
	{
		title: 'Invisible session failure',
		description:
			'Without supervision, agents can stop progressing while the team assumes they are still working. PollyPM makes lane health visible.',
	},
	{
		title: 'Shared checkout collisions',
		description:
			'Several agents editing the same working tree create avoidable merge pain. PollyPM uses worktrees to isolate changes.',
	},
	{
		title: 'Provider dependency risk',
		description:
			'If one provider rate-limits or fails, execution stalls. PollyPM keeps provider routing explicit so work can move again.',
	},
	{
		title: 'Lost operating context',
		description:
			'Teams often forget why a lane was launched or what happened during a run. PollyPM keeps projects and sessions organized around explicit tasks.',
	},
];
---

<DocsFrame
	title="Concepts and Architecture | PollyPM Docs"
	description="Understand the core concepts, operating model, and architecture layers behind PollyPM."
	heroTitle="How PollyPM is organized."
	heroSummary="PollyPM is not just a launcher for AI agents. It is a control layer that keeps projects, sessions, worktrees, and operator actions connected so multi-agent execution stays manageable."
	currentPath="/docs/concepts"
	pills={['Concepts', 'Architecture', 'Lifecycle']}
>
	<section class="docs-section">
		<div class="docs-section-head">
			<span class="docs-eyebrow">Core Concepts</span>
			<h2>The units PollyPM uses to turn several agent runs into one operable system.</h2>
			<p class="docs-section-copy">These concepts are the vocabulary for everything else in the product and docs.</p>
		</div>

		<div class="docs-grid">
			{
				concepts.map((concept) => (
					<article class="docs-card">
						<strong>{concept.title}</strong>
						<p>{concept.description}</p>
					</article>
				))
			}
		</div>
	</section>

	<section class="docs-section">
		<div class="docs-split">
			<div class="docs-block">
				<div class="docs-section-head">
					<span class="docs-eyebrow">Architecture</span>
					<h2>PollyPM sits between human direction and raw agent execution.</h2>
				</div>
				<ul class="docs-timeline">
					{architectureLayers.map((item) => (
						<li class="docs-timeline-item">
							<span class="docs-step-index">Layer</span>
							<strong>{item.title}</strong>
							<span>{item.description}</span>
						</li>
					))}
				</ul>
			</div>

			<div class="docs-block">
				<div class="docs-section-head">
					<span class="docs-eyebrow">Lifecycle</span>
					<h2>Most runs follow the same loop from planning to promotion.</h2>
				</div>
				<ul class="docs-timeline">
					{lifecycle.map((item) => (
						<li class="docs-timeline-item">
							<span class="docs-step-index">Phase</span>
							<strong>{item.title}</strong>
							<span>{item.description}</span>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<section class="docs-section">
		<div class="docs-section-head">
			<span class="docs-eyebrow">Failure Modes</span>
			<h2>What PollyPM is designed to prevent.</h2>
			<p class="docs-section-copy">The value is not only more throughput. It is fewer coordination failures while agents are running.</p>
		</div>

		<div class="docs-grid two-up">
			{
				failureModes.map((item) => (
					<article class="docs-card">
						<strong>{item.title}</strong>
						<p>{item.description}</p>
					</article>
				))
			}
		</div>

		<div class="docs-cta">
			<div>
				<span class="docs-card-label">Recommended sequence</span>
				<strong>Read this page after getting started.</strong>
				<p class="docs-section-copy">Use the getting started guide to launch PollyPM. Use this page to understand why the project, session, and worktree model exists in the first place.</p>
			</div>

			<div class="docs-actions">
				<a class="docs-button primary" href="/docs/getting-started">Open getting started</a>
				<a class="docs-button secondary" href="/docs/cli-reference">Open CLI reference</a>
			</div>
		</div>
	</section>
</DocsFrame>
