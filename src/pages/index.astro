---
import Layout from '../layouts/Layout.astro';

const featureShowcase = [
	{
		icon: 'MC',
		title: 'Mission control',
		description:
			'Watch every lane, owner, provider, and recovery event from one operator view instead of chasing tabs and shell history.',
	},
	{
		icon: 'GW',
		title: 'Git-safe workflows',
		description:
			'Every active lane runs in an isolated worktree so AI output stays attributable, reviewable, and mergeable.',
	},
	{
		icon: 'PF',
		title: 'Provider failover',
		description:
			'Reroute around quota hits, outages, or account limits without throwing away execution context.',
	},
	{
		icon: 'HS',
		title: 'Health signals',
		description:
			'Detect stalled, recovered, and ready-for-review sessions before work silently disappears.',
	},
	{
		icon: 'OP',
		title: 'Operator controls',
		description:
			'Intervene, checkpoint, and hand off at the right moment instead of restarting a lane from scratch.',
	},
	{
		icon: 'CL',
		title: 'One CLI surface',
		description:
			'Launch, monitor, recover, and review with one operating model instead of improvised scripts and conventions.',
	},
];

const operatingStats = [
	{ value: '1', label: 'control plane for multi-agent execution' },
	{ value: 'N', label: 'managed lanes running in parallel' },
	{ value: '24/7', label: 'visibility into health and handoff state' },
];

const operatingSteps = [
	{
		index: '01',
		title: 'Frame the project once',
		description:
			'Define the project, assign repos, and split the work into lanes with clear ownership before execution starts.',
	},
	{
		index: '02',
		title: 'Launch managed delivery lanes',
		description:
			'PollyPM starts agents inside tmux-backed sessions with isolated worktrees and a known operating path.',
	},
	{
		index: '03',
		title: 'Recover instead of restarting',
		description:
			'When a lane drifts, stalls, or hits provider limits, the operator can recover it without losing project context.',
	},
];

const proofCards = [
	{
		label: 'For teams moving beyond demos',
		copy: 'Useful AI output is not the bottleneck anymore. Coordination, recoverability, and merge safety are.',
	},
	{
		label: 'For engineering managers and operators',
		copy: 'PollyPM gives you a system you can inspect, intervene in, and explain to the rest of the team.',
	},
	{
		label: 'For real repositories',
		copy: 'The product is designed around the friction that appears when many agents touch Git, providers, and long-running tasks at once.',
	},
];

const docLinks = [
	{ title: 'Get Started', href: '/docs/getting-started' },
	{ title: 'Concepts', href: '/docs/concepts' },
	{ title: 'CLI Reference', href: '/docs/cli-reference' },
	{ title: 'Docs Hub', href: '/docs' },
];

const demoTimeline = [
	{ phase: 'Launch', detail: 'Create scoped lanes with isolated worktrees and known owners.' },
	{ phase: 'Monitor', detail: 'Track health, stall signals, provider paths, and review checkpoints.' },
	{ phase: 'Recover', detail: 'Reroute a lane without losing project context or branch hygiene.' },
];
---

<Layout
	title="PollyPM | Multi-Agent Delivery, Actually Operable"
	description="PollyPM is the control plane for multi-agent software delivery, with lane supervision, isolated worktrees, provider failover, and an operator-grade CLI."
>
	<div class="home">
		<header class="masthead">
			<div class="shell masthead-bar">
				<a class="brand" href="/" aria-label="PollyPM home">
					<span class="brand-badge">PP</span>
					<span class="brand-text">
						<small>AI project management</small>
						<strong>PollyPM</strong>
					</span>
				</a>

				<nav class="masthead-nav" aria-label="Primary">
					<a href="#features">Features</a>
					<a href="#operating-model">How it works</a>
					<a href="#proof">Why it matters</a>
					<a href="/docs">Docs</a>
				</nav>

				<a class="nav-cta" href="/docs/getting-started">Start onboarding</a>
			</div>
		</header>

		<main id="main-content">
			<section class="hero">
				<div class="shell hero-grid">
					<div class="hero-copy">
						<span class="hero-eyebrow">A control plane for AI delivery teams</span>
						<h1>Multi-agent software delivery needs orchestration, not optimism.</h1>
						<p class="hero-lead">
							PollyPM gives engineering teams one operating layer for launching work, watching lane
							health, isolating Git changes, and recovering execution when providers or sessions go
							sideways.
						</p>

						<div class="hero-actions">
							<a class="button button-primary" href="/docs/getting-started">Read getting started</a>
							<a class="button button-secondary" href="#features">Explore the platform</a>
						</div>

						<ul class="hero-flags" aria-label="Key capabilities">
							<li>tmux-backed supervision</li>
							<li>provider failover</li>
							<li>isolated worktrees</li>
							<li>operator-first CLI</li>
						</ul>

						<div class="hero-command-card">
							<span>Quick start path</span>
							<code>npm install -g pollypm && pollypm init && pollypm launch</code>
						</div>
					</div>

					<div class="hero-visual" aria-hidden="true">
						<div class="visual-orbit orbit-large"></div>
						<div class="visual-orbit orbit-small"></div>

						<div class="signal-card signal-card-primary">
							<div class="signal-topline">
								<span class="signal-dot"></span>
								<span>project: launch-redesign</span>
							</div>
							<strong>All delivery lanes visible</strong>
							<p>Operator state stays legible even when several agents are shipping in parallel.</p>
						</div>

						<div class="terminal-frame">
							<div class="terminal-bar">
								<div class="terminal-lights">
									<span></span>
									<span></span>
									<span></span>
								</div>
								<code>pollypm monitor --project launch-redesign</code>
							</div>

							<div class="terminal-body">
								<div class="terminal-row">
									<span class="lane-name">landing-site</span>
									<span class="lane-copy"><strong>codex</strong> homepage redesign in worktree</span>
									<span class="lane-state healthy">healthy</span>
								</div>
								<div class="terminal-row">
									<span class="lane-name">docs-pass</span>
									<span class="lane-copy"><strong>claude</strong> revise rollout documentation</span>
									<span class="lane-state healthy">healthy</span>
								</div>
								<div class="terminal-row">
									<span class="lane-name">api-followup</span>
									<span class="lane-copy"><strong>fallback</strong> rerouted after quota event</span>
									<span class="lane-state recovered">recovered</span>
								</div>
								<div class="terminal-row">
									<span class="lane-name">review-lane</span>
									<span class="lane-copy"><strong>operator</strong> ready for checkpoint</span>
									<span class="lane-state waiting">ready</span>
								</div>
							</div>
						</div>

						<div class="signal-strip">
							<div>
								<span>Providers</span>
								<strong>Swappable mid-run</strong>
							</div>
							<div>
								<span>Git state</span>
								<strong>Separated by lane</strong>
							</div>
							<div>
								<span>Recovery</span>
								<strong>Operational, not ad hoc</strong>
							</div>
						</div>
					</div>
				</div>

				<div class="shell stat-ribbon">
					{
						operatingStats.map((stat) => (
							<div class="stat-item">
								<strong>{stat.value}</strong>
								<span>{stat.label}</span>
							</div>
						))
					}
				</div>
			</section>

			<section class="section feature-stage" id="features">
				<div class="shell">
					<div class="section-heading">
						<span class="section-kicker">Feature Showcase</span>
						<h2>Built for the ugly parts of real multi-agent execution.</h2>
						<p>
							The hard problem is not getting an agent to produce output once. It is keeping many
							lanes observable, recoverable, and safe to merge while the project is still moving.
						</p>
					</div>

					<div class="feature-grid">
						{
							featureShowcase.map((feature) => (
								<article class="feature-tile">
									<span class="feature-icon" aria-hidden="true">{feature.icon}</span>
									<h3>{feature.title}</h3>
									<p>{feature.description}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="section demo-stage" id="demo">
				<div class="shell">
					<div class="demo-panel">
						<div class="demo-copy">
							<span class="section-kicker">Animated Demo</span>
							<h2>A project moving through launch, monitoring, and recovery.</h2>
							<p>
								The homepage demo is not decorative chrome. It shows the operating loop PollyPM is
								built for: structured launch, live supervision, and recovery when one lane drifts.
							</p>
						</div>

						<div class="demo-visual" aria-hidden="true">
							<div class="demo-track"></div>
							<div class="demo-pulse demo-pulse-one"></div>
							<div class="demo-pulse demo-pulse-two"></div>
							<div class="demo-node demo-node-one">
								<span>01</span>
								<strong>Launch</strong>
							</div>
							<div class="demo-node demo-node-two">
								<span>02</span>
								<strong>Monitor</strong>
							</div>
							<div class="demo-node demo-node-three">
								<span>03</span>
								<strong>Recover</strong>
							</div>
						</div>

						<div class="demo-timeline">
							{
								demoTimeline.map((item) => (
									<article class="timeline-card">
										<span>{item.phase}</span>
										<p>{item.detail}</p>
									</article>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<section class="section operating-model" id="operating-model">
				<div class="shell operating-grid">
					<div class="section-heading left-align">
						<span class="section-kicker">Operating Model</span>
						<h2>Run AI agents like delivery lanes, not disconnected experiments.</h2>
						<p>
							PollyPM adds the management layer between a capable model and a process a team can
							trust under pressure.
						</p>
					</div>

					<div class="steps-grid">
						{
							operatingSteps.map((step) => (
								<article class="step-card">
									<span class="step-index">{step.index}</span>
									<h3>{step.title}</h3>
									<p>{step.description}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="section proof-zone" id="proof">
				<div class="shell">
					<div class="proof-banner">
						<div class="section-heading left-align">
							<span class="section-kicker">Why Teams Switch</span>
							<h2>PollyPM replaces manual coordination with a system you can actually operate.</h2>
						</div>

						<div class="proof-grid">
							{
								proofCards.map((card) => (
									<article class="proof-card">
										<span>{card.label}</span>
										<p>{card.copy}</p>
									</article>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<section class="section final-cta">
				<div class="shell final-cta-panel">
					<div>
						<span class="section-kicker">Getting Started</span>
						<h2>Bring PollyPM into a real repo with a clear first step.</h2>
						<p>
							Start with installation, provider setup, and the first managed project. The onboarding
							path is structured to get a team from zero to an operable lane model quickly.
						</p>
					</div>

					<div class="cta-actions">
						<a class="button button-primary" href="/docs/getting-started">Open getting started</a>
						<a class="button button-secondary" href="/docs">Browse docs</a>
					</div>

					<div class="cta-command">
						<span>First run</span>
						<code>pollypm init</code>
					</div>

					<div class="doc-pills" aria-label="Documentation links">
						{docLinks.map((link) => <a href={link.href}>{link.title}</a>)}
					</div>
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
	.home {
		position: relative;
		overflow: clip;
	}

	.home::before,
	.home::after {
		content: '';
		position: fixed;
		inset: auto;
		pointer-events: none;
		filter: blur(70px);
		opacity: 0.7;
		z-index: 0;
	}

	.home::before {
		top: 6rem;
		left: -7rem;
		width: 20rem;
		height: 20rem;
		background: rgba(255, 122, 76, 0.22);
	}

	.home::after {
		right: -4rem;
		bottom: 12rem;
		width: 24rem;
		height: 24rem;
		background: rgba(104, 225, 199, 0.16);
	}

	.shell {
		position: relative;
		z-index: 1;
		width: min(1180px, calc(100% - 2rem));
		margin: 0 auto;
	}

	.masthead {
		position: sticky;
		top: 0;
		z-index: 25;
		padding: 1rem 0 0;
	}

	.masthead-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.15rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 999px;
		background:
			linear-gradient(180deg, rgba(8, 17, 30, 0.86), rgba(8, 17, 30, 0.64)),
			rgba(8, 17, 30, 0.72);
		backdrop-filter: blur(20px);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		text-decoration: none;
	}

	.brand-badge {
		display: grid;
		place-items: center;
		width: 2.85rem;
		height: 2.85rem;
		border-radius: 18px;
		font-family: 'Space Grotesk', sans-serif;
		font-weight: 700;
		letter-spacing: -0.05em;
		color: #09111a;
		background:
			linear-gradient(135deg, #7cf2d6 0%, #f4d177 50%, #ff8357 100%);
		box-shadow:
			0 12px 30px rgba(255, 131, 87, 0.25),
			inset 0 1px 0 rgba(255, 255, 255, 0.65);
	}

	.brand-text small,
	.brand-text strong {
		display: block;
	}

	.brand-text small {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: rgba(236, 243, 255, 0.62);
	}

	.brand-text strong {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 1rem;
		letter-spacing: -0.03em;
	}

	.masthead-nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.3rem;
	}

	.masthead-nav a,
	.nav-cta,
	.doc-pills a {
		text-decoration: none;
	}

	.masthead-nav a {
		padding: 0.55rem 0.9rem;
		border-radius: 999px;
		color: rgba(236, 243, 255, 0.76);
		transition:
			background 180ms ease,
			color 180ms ease,
			transform 180ms ease;
	}

	.masthead-nav a:hover,
	.masthead-nav a:focus-visible {
		background: rgba(255, 255, 255, 0.06);
		color: #ffffff;
		transform: translateY(-1px);
	}

	.nav-cta,
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		font-weight: 700;
		letter-spacing: -0.02em;
		transition:
			transform 180ms ease,
			box-shadow 180ms ease,
			background 180ms ease,
			border-color 180ms ease;
	}

	.nav-cta {
		padding: 0.8rem 1.1rem;
		color: #07111f;
		background: #eef4ff;
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.18);
	}

	.nav-cta:hover,
	.nav-cta:focus-visible,
	.button:hover,
	.button:focus-visible,
	.doc-pills a:hover,
	.doc-pills a:focus-visible {
		transform: translateY(-2px);
	}

	.hero {
		position: relative;
		padding: 5rem 0 2rem;
	}

	.hero::before {
		content: '';
		position: absolute;
		inset: 2rem 0 auto;
		height: 42rem;
		background:
			radial-gradient(circle at 15% 18%, rgba(255, 131, 87, 0.26), transparent 24%),
			radial-gradient(circle at 78% 22%, rgba(124, 242, 214, 0.18), transparent 22%),
			linear-gradient(180deg, rgba(10, 20, 36, 0.25), rgba(10, 20, 36, 0));
		z-index: 0;
	}

	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
		background-size: 56px 56px;
		mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.5), transparent 82%);
		opacity: 0.32;
		pointer-events: none;
		z-index: 0;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		gap: 2rem;
		align-items: center;
	}

	.hero-copy,
	.hero-visual,
	.stat-ribbon,
	.feature-tile,
	.demo-panel,
	.timeline-card,
	.step-card,
	.proof-banner,
	.final-cta-panel {
		animation: rise-in 700ms ease both;
	}

	.hero-copy {
		animation-delay: 80ms;
	}

	.hero-eyebrow,
	.section-kicker,
	.feature-kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.45rem 0.8rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		font-size: 0.76rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: #ffdca2;
		background: rgba(255, 255, 255, 0.04);
	}

	.hero h1 {
		margin: 1.2rem 0 1rem;
		max-width: 12ch;
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(3.8rem, 8vw, 6.6rem);
		line-height: 0.94;
		letter-spacing: -0.07em;
	}

	.hero-lead,
	.section-heading p,
	.feature-copy p,
	.step-card p,
	.proof-card p,
	.final-cta-panel p {
		color: rgba(236, 243, 255, 0.76);
		font-size: 1.08rem;
		line-height: 1.75;
	}

	.hero-lead {
		max-width: 38rem;
	}

	.hero-actions,
	.cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.95rem;
		margin-top: 1.8rem;
	}

	.button {
		padding: 0.95rem 1.35rem;
		border: 1px solid transparent;
	}

	.button-primary {
		color: #07111f;
		background: linear-gradient(135deg, #7cf2d6 0%, #f6d67d 52%, #ff8357 100%);
		box-shadow: 0 20px 45px rgba(255, 131, 87, 0.22);
	}

	.button-secondary {
		color: #f2f6ff;
		border-color: rgba(255, 255, 255, 0.14);
		background: rgba(255, 255, 255, 0.04);
	}

	.hero-flags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		padding: 0;
		margin: 1.8rem 0 0;
		list-style: none;
	}

	.hero-flags li,
	.feature-points li,
	.doc-pills a {
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: rgba(255, 255, 255, 0.04);
	}

	.hero-flags li {
		padding: 0.68rem 0.95rem;
		border-radius: 999px;
		color: rgba(236, 243, 255, 0.88);
	}

	.hero-command-card,
	.cta-command {
		display: inline-flex;
		flex-direction: column;
		gap: 0.55rem;
		margin-top: 1.15rem;
		padding: 1rem 1.1rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 22px;
		background: rgba(255, 255, 255, 0.045);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
	}

	.hero-command-card span,
	.cta-command span {
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: rgba(236, 243, 255, 0.58);
	}

	.hero-command-card code,
	.cta-command code {
		font-size: 0.95rem;
		color: #f8fbff;
		word-break: break-word;
	}

	.hero-visual {
		position: relative;
		min-height: 42rem;
		padding: 2rem 0;
		animation-delay: 180ms;
	}

	.visual-orbit {
		position: absolute;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 999px;
	}

	.orbit-large {
		inset: 4rem 2rem 5rem 4rem;
		background:
			radial-gradient(circle at center, rgba(124, 242, 214, 0.08), transparent 55%);
		animation: slow-spin 20s linear infinite;
	}

	.orbit-small {
		inset: 8rem 7rem 9rem 8rem;
		background:
			radial-gradient(circle at center, rgba(255, 131, 87, 0.1), transparent 58%);
		animation: slow-spin-reverse 16s linear infinite;
	}

	.signal-card,
	.terminal-frame,
	.signal-strip,
	.stat-ribbon,
	.feature-tile,
	.demo-panel,
	.timeline-card,
	.step-card,
	.proof-banner,
	.final-cta-panel {
		position: relative;
		border: 1px solid rgba(255, 255, 255, 0.09);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02)),
			rgba(9, 17, 31, 0.82);
		box-shadow:
			0 30px 70px rgba(0, 0, 0, 0.26),
			inset 0 1px 0 rgba(255, 255, 255, 0.05);
		backdrop-filter: blur(18px);
	}

	.signal-card::before,
	.terminal-frame::before,
	.feature-tile::before,
	.demo-panel::before,
	.timeline-card::before,
	.step-card::before,
	.proof-banner::before,
	.final-cta-panel::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		padding: 1px;
		background: linear-gradient(
			135deg,
			rgba(255, 255, 255, 0.24),
			rgba(255, 255, 255, 0.03) 30%,
			rgba(124, 242, 214, 0.15) 65%,
			rgba(255, 131, 87, 0.18)
		);
		-webkit-mask:
			linear-gradient(#fff 0 0) content-box,
