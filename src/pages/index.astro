---
import Layout from '../layouts/Layout.astro';

const features = [
	{
		title: 'Coordinate many agents',
		description:
			'Run Claude, Codex, and other tools as one delivery system instead of a pile of disconnected chats and terminals.',
	},
	{
		title: 'See session health',
		description:
			'Heartbeat monitoring makes stalled, healthy, and recovered lanes visible before work silently disappears.',
	},
	{
		title: 'Route around provider limits',
		description:
			'Move work to another provider or account when quotas, outages, or model availability interrupt execution.',
	},
	{
		title: 'Keep parallel changes clean',
		description:
			'Separate worktrees give each lane an isolated Git workspace so output stays reviewable and mergeable.',
	},
	{
		title: 'Operate from one CLI',
		description:
			'Launch, monitor, hand off, and recover work from `pollypm` instead of reconstructing state from shell history.',
	},
	{
		title: 'Track work across repos',
		description:
			'Keep project-level visibility even when the delivery path spans several repositories, services, or branches.',
	},
];

const workflow = [
	{
		title: 'Define the project',
		description:
			'Describe the job, register the repositories involved, and decide which lanes need to run in parallel.',
	},
	{
		title: 'Launch managed lanes',
		description:
			'PollyPM starts agent sessions inside tmux with scoped tasks, known ownership, and isolated worktrees.',
	},
	{
		title: 'Monitor and intervene',
		description:
			'Operators can watch health, fail over providers, hand work back for review, and keep the project moving.',
	},
];

const docCards = [
	{
		title: 'Getting Started',
		description: 'Install PollyPM, configure providers, and launch a real first project.',
	},
	{
		title: 'Operating Model',
		description: 'Understand projects, sessions, worktrees, provider paths, and operator checkpoints.',
	},
	{
		title: 'Day-One Operations',
		description: 'Learn the monitor, handoff, and recovery loop that keeps long-running agent work stable.',
	},
];
---

<Layout
	title="PollyPM | The PM Layer for Multi-Agent Software Delivery"
	description="PollyPM orchestrates Claude, Codex, and other AI agents across projects with tmux-backed supervision, worktree isolation, provider failover, and an operator-facing CLI."
>
	<div class="page-shell">
		<header class="site-header">
			<div class="container nav-row">
				<a class="brand" href="/">
					<span class="brand-mark"><span>PP</span></span>
					<span class="brand-copy">
						<small>AI Project Management</small>
						<strong>PollyPM</strong>
					</span>
				</a>
				<nav class="nav-links" aria-label="Primary">
					<a href="#features">Features</a>
					<a href="#how-it-works">How It Works</a>
					<a href="#docs">Docs</a>
					<a href="/docs/getting-started">Getting Started</a>
				</nav>
			</div>
		</header>

		<main>
			<section class="hero">
				<div class="container hero-grid">
					<div class="hero-copy">
						<span class="eyebrow">AI project management for engineering teams</span>
						<h1>PollyPM is the control plane for multi-agent software delivery.</h1>
						<p>
							When teams start using several AI agents at once, the failure mode is not model quality.
							It is coordination. PollyPM gives you one place to launch work, monitor session health,
							isolate Git changes, reroute around provider failures, and keep the whole project
							operable.
						</p>
						<div class="button-row">
							<a class="button button-primary" href="/docs/getting-started">Read getting started</a>
							<a class="button button-secondary" href="#how-it-works">See how it works</a>
						</div>
						<div class="hero-notes" aria-label="Product highlights">
							<span class="chip">tmux-backed sessions</span>
							<span class="chip">heartbeat supervision</span>
							<span class="chip">provider failover</span>
							<span class="chip">isolated worktrees</span>
						</div>
					</div>

					<div class="hero-panel">
						<div class="panel-header">
							<span class="status-pill">Live</span>
							<span>pollypm monitor</span>
						</div>
						<div class="terminal-card">
							<div class="terminal-bar">
								<div class="terminal-dots">
									<span></span>
									<span></span>
									<span></span>
								</div>
								<span class="terminal-label">pollypm monitor --project launch-redesign</span>
							</div>
							<div class="terminal-output">
								<div class="terminal-line">
									<small>frontend-refresh</small>
									<code><span class="provider">codex</span> landing page in isolated worktree</code>
									<span class="status-tag">healthy</span>
								</div>
								<div class="terminal-line">
									<small>docs-pass</small>
									<code><span class="provider">claude</span> docs pass and rollout notes</code>
									<span class="status-tag">healthy</span>
								</div>
								<div class="terminal-line">
									<small>api-followup</small>
									<code><span class="provider">fallback</span> reassigned after quota hit</code>
									<span class="status-tag">recovered</span>
								</div>
							</div>
						</div>

						<div class="metrics">
							<div class="metric">
								<span>1 CLI</span>
								<p>to launch, monitor, and recover every managed lane</p>
							</div>
							<div class="metric">
								<span>N agents</span>
								<p>running in parallel without sharing a working directory</p>
							</div>
							<div class="metric">
								<span>24/7</span>
								<p>visibility into health, stalls, and intervention points</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="section" id="features">
				<div class="container">
					<div class="section-heading">
						<h2>What PollyPM is for</h2>
						<p>
							PollyPM is for teams that already know AI agents can produce useful work, but need
							that work to stay organized, inspectable, and safe to run in parallel.
						</p>
					</div>

					<div class="card-grid">
						{
							features.map((feature) => (
								<article class="card">
									<strong>{feature.title}</strong>
									<p>{feature.description}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="section" id="how-it-works">
				<div class="container">
					<div class="section-heading">
						<h2>How PollyPM keeps agent work under control</h2>
						<p>
							The model is simple: define the project once, let lanes execute independently, and
							give operators the controls they need when something drifts or stalls.
						</p>
					</div>

					<div class="steps-grid">
						{
							workflow.map((step, index) => (
								<article class="step card">
									<span class="step-index">0{index + 1}</span>
									<strong>{step.title}</strong>
									<p>{step.description}</p>
								</article>
							))
						}
					</div>

					<div class="split-grid">
						<div class="info-panel">
							<div class="section-heading">
								<h2>Why teams use it</h2>
								<p>
									PollyPM adds the missing management layer between a good model and a reliable
									delivery process.
								</p>
							</div>
							<ul>
								<li>Know which sessions are healthy, stalled, recovered, or ready for review.</li>
								<li>Keep multiple tasks moving without merging unrelated output into one branch.</li>
								<li>Swap providers or accounts without rebuilding the whole operating flow.</li>
								<li>Review AI output as normal Git work instead of opaque terminal state.</li>
							</ul>
						</div>

						<div class="info-panel">
							<div class="section-heading">
								<h2>What it replaces</h2>
								<p>
									Most multi-agent setups fail because coordination stays manual. PollyPM removes
									the brittle parts.
								</p>
							</div>
							<ul>
								<li>No browser-tab babysitting to see whether a long run silently died.</li>
								<li>No shared working directory where several agents overwrite each other.</li>
								<li>No guesswork about which provider path a lane is currently using.</li>
								<li>No reconstructing project history from shell logs and memory.</li>
							</ul>
						</div>
					</div>
				</div>
			</section>

			<section class="section" id="docs">
				<div class="container">
					<div class="section-heading">
						<h2>Start with the operating model</h2>
						<p>
							The docs are written for operators and engineers who need to make agent execution work
							reliably in a real repository, not just in a demo.
						</p>
					</div>

					<div class="docs-grid">
						{
							docCards.map((card) => (
								<article class="doc-card">
									<strong>{card.title}</strong>
									<p>{card.description}</p>
								</article>
							))
						}
					</div>

					<div class="cta-panel">
						<div>
							<h2>PollyPM is what teams add after “just use more agents” stops being enough.</h2>
							<p>
								If you need multi-agent work to be observable, recoverable, and safe to merge,
								start with the CLI and build from there.
							</p>
						</div>
						<div class="button-row">
							<a class="button button-primary" href="/docs/getting-started">Open the docs</a>
							<a class="button button-secondary" href="#features">Review capabilities</a>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="container footer-row">
				<div>
					<a class="brand" href="/">
						<span class="brand-mark"><span>PP</span></span>
						<span class="brand-copy">
							<small>PollyPM</small>
							<strong>AI project management for multi-agent engineering</strong>
						</span>
					</a>
					<p>
						Coordinate AI agents like a software delivery system, not a loose collection of tabs,
						terminals, and half-finished branches.
					</p>
				</div>
				<nav class="footer-links" aria-label="Footer">
					<a href="#features">Features</a>
					<a href="#how-it-works">How it works</a>
					<a href="/docs/getting-started">Docs</a>
				</nav>
			</div>
		</footer>
	</div>
</Layout>
